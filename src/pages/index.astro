---
import Layout from "../layouts/Layout.astro"
import Sidebar from "../components/Sidebar.astro"
import SobreMi from "../components/SobreMi.astro"
import Experiencia from "../components/Experiencia.astro"
import Proyectos from "../components/Proyectos.astro"
import Contacto from "../components/Contacto.astro"
import Footer from "../components/Footer.astro"
---

<Layout title="Jose Salas · Desarrollador de software">
  <div class="mx-auto max-w-[1100px] px-6 lg:grid lg:grid-cols-[260px_1fr] lg:gap-16">
    <Sidebar />
    <div class="min-w-0 max-w-3xl">
      <main>
        <SobreMi />
        <Experiencia />
        <Proyectos />
        <Contacto />
      </main>
      <Footer />
    </div>
  </div>
</Layout>
