---
import "../styles/global.css"
import { ClientRouter } from "astro:transitions"
import { url } from "../utils/url"

const {
  title,
  description = "Portfolio personal de Jose Antonio Salas, Desarrollador de Software y Técnico IT. Proyectos, experiencia y formas de contacto.",
  image = url("og-image.png")
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jose Antonio Salas" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Jose Salas — Portfolio" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />

    <ClientRouter />
  </head>

  <body class="bg-paper text-ink font-sans antialiased">
    <slot />

    <script>
      import { initReveal } from "../utils/reveal.js"
      initReveal()
      document.addEventListener("astro:page-load", initReveal)
    </script>

    <script>
      // Monigotes clicables que bajan el scroll a la siguiente sección
      function initScrollBuddies() {
        document.querySelectorAll("[data-scroll-next]").forEach((el) => {
          (el as HTMLElement).onclick = () => {
            const current = el.closest("section")
            const sections = Array.from(document.querySelectorAll("main section"))
            const next = current ? sections[sections.indexOf(current) + 1] : sections[0]
            if (next) {
              next.scrollIntoView({ behavior: "smooth" })
            } else {
              window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" })
            }
          }
        })
      }

      initScrollBuddies()
      document.addEventListener("astro:page-load", initScrollBuddies)
    </script>
  </body>
</html>
