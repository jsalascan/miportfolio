---
import "../styles/global.css"
import { ClientRouter } from "astro:transitions"
import { url } from "../utils/url"

const {
  title,
  description = "Desarrollador de software en Tenerife. Experiencia, proyectos y contacto.",
  image = url("og-image.png")
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jose Antonio Salas" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="jsalascan.dev" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />

    <!-- Tema elegido en el footer: se aplica antes de pintar para que no
         parpadee, y al documento entrante en cada navegación de ClientRouter,
         que sustituye los atributos de <html>. -->
    <script is:inline>
      function aplicarTema(doc) {
        let tema = null
        try {
          tema = localStorage.getItem("tema")
        } catch {}
        if (tema === "claro" || tema === "oscuro") doc.documentElement.dataset.tema = tema
      }
      aplicarTema(document)
      document.addEventListener("astro:before-swap", (e) => aplicarTema(e.newDocument))
    </script>

    <ClientRouter />
  </head>

  <body class="bg-bg text-fg font-sans antialiased">
    <slot />
  </body>
</html>
