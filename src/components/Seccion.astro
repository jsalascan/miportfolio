---
interface Props {
  id: string
  titulo: string
}

const { id, titulo } = Astro.props
---

<section
  id={id}
  aria-labelledby={`${id}-titulo`}
  class="scroll-mt-8 py-12 lg:py-16 border-t border-rule first:border-t-0 first:pt-8 lg:first:pt-16"
>
  <h2 id={`${id}-titulo`} class="rotulo mb-6">{titulo}</h2>
  <slot />
</section>
