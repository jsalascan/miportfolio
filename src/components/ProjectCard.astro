---
import { url as toUrl } from "../utils/url"

const { title, description, tags, url, demo, image, badge, pinned } = Astro.props

// La tarjeta entera lleva a la demo. Sin demo, al repositorio: hacer clic y no
// ir a ninguna parte sería peor que llegar al código.
const destino = demo ?? url

// Píldora sólida por tipo de aviso: verde para lo que sigue vivo, naranja
// para lo recién llegado. Cualquier badge nuevo que no esté aquí cae en gris.
const badgeStyles: Record<string, string> = {
  Actualizado: "bg-ok text-paper",
  Nuevo: "bg-accent text-paper",
}
const badgeClass = badge ? (badgeStyles[badge] ?? "bg-ink-soft text-paper") : ""

// La fijada va en horizontal en escritorio (imagen a un lado, texto al otro)
// para que "ancho completo" no signifique "el doble de alta".
const articleClass = pinned
  ? "group relative bg-paper-2 border-2 border-edge rounded-3xl overflow-hidden hover:border-accent hover:-translate-y-1 transition-all md:flex md:items-stretch"
  : "group relative h-full bg-paper-2 border-2 border-edge rounded-3xl overflow-hidden hover:border-accent hover:-translate-y-1 transition-all"

const bannerWrapClass = pinned
  ? "border-b-2 md:border-b-0 md:border-r-2 border-edge overflow-hidden md:w-2/5 md:shrink-0"
  : "border-b-2 border-edge overflow-hidden"

const bannerImgClass = pinned
  ? "w-full aspect-[1200/630] md:aspect-auto md:h-full object-cover"
  : "w-full aspect-[1200/630] object-cover"

const bodyClass = pinned ? "p-6 md:flex-1 md:flex md:flex-col md:justify-center" : "p-6"
---

<article class={articleClass}>

  <!-- Banner -->
  {image && (
    <div class={bannerWrapClass}>
      <img
        src={toUrl(image)}
        alt={`Banner de ${title}`}
        class={bannerImgClass}
      />
    </div>
  )}

  <div class={bodyClass}>

  <!-- Cabecera -->
  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Enlace extendido: el `after` cubre la tarjeta entera para que se
           pueda hacer clic en cualquier parte, sin anidar enlaces (lo que sería
           HTML inválido) y dejando un único destino en el orden de tabulación. -->
      <h3 class="font-black text-lg group-hover:text-accent transition-colors">
        <a
          href={destino}
          target="_blank"
          class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm"
        >
          {title}
        </a>
      </h3>

      <!-- Píldora sólida, no el borde hueco del RBadge -->
      {badge && (
        <span class={`inline-flex items-center px-2.5 py-1 font-mono text-[0.7rem] font-bold uppercase tracking-wide leading-none rounded-full ${badgeClass}`}>
          {badge}
        </span>
      )}
    </div>

    <!-- `relative z-10` lo levanta por encima del enlace extendido de la
         tarjeta, que si no se tragaría este clic. -->
    <div class="relative z-10 flex items-center gap-3 shrink-0">
      <a href={url} target="_blank" class="font-mono text-xs uppercase text-ink-soft hover:text-accent transition-colors">
        GitHub ↗
      </a>
    </div>
  </div>

  <!-- Descripción -->
  <p class="text-sm text-ink-soft leading-relaxed mb-4">
    {description}
  </p>

  <!-- Tags -->
  <div class="flex flex-wrap gap-2">
    {tags.map((tag: string) => (
      <span class="px-2.5 py-0.5 text-xs font-bold bg-paper border-2 border-edge text-ink rounded-lg">
        {tag}
      </span>
    ))}
  </div>

  </div>
</article>
