---
import SectionTitle from "./SectionTitle.astro"
import Monigote from "./Monigote.astro"
import FormularioContacto from "./FormularioContacto.astro"

const social = [
  { label: "GitHub", url: "https://github.com/jsalascan" },
  { label: "LinkedIn", url: "https://www.linkedin.com/in/jsalascan/" },
]
---

<section id="contacto" class="py-24 border-t-2 border-edge">
  <div class="max-w-5xl mx-auto px-6">

    <SectionTitle number="04" label="Contacto" />

    <div class="grid md:grid-cols-2 gap-16 items-start">
      <div class="reveal md:pt-[86px]">
        <p class="text-3xl font-black leading-snug mb-4">
          ¿Hablamos?
        </p>
        <p class="text-ink-soft leading-relaxed mb-6">
          Si tienes un proyecto en mente, una oferta o simplemente quieres
          saludar, escríbeme a través del formulario y te respondo lo antes posible.
        </p>
        <div class="flex flex-wrap gap-3">
          {social.map((item) => (
            <a
              href={item.url}
              target="_blank"
              class="px-5 py-2.5 border-2 border-edge text-ink text-sm font-bold rounded-full hover:border-ink transition-colors"
            >
              {item.label} ↗
            </a>
          ))}
        </div>
      </div>

      <!-- Formulario derecha -->
      <div class="reveal reveal-delay-1 flex flex-col items-center">
        <Monigote variant="wave" class="w-20 -mb-4 relative z-10" />

        <div class="w-full p-8 bg-paper-2 border-2 border-edge rounded-3xl">
          <FormularioContacto />
        </div>
      </div>

    </div>
  </div>
</section>
