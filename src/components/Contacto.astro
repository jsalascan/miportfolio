---
import SectionTitle from "./SectionTitle.astro"
import Monigote from "./Monigote.astro"
import FormularioContacto from "./FormularioContacto.astro"

const social = [
  { label: "GitHub", url: "https://github.com/jsalascan" },
  { label: "LinkedIn", url: "https://www.linkedin.com/in/jsalascan/" },
]
---

<section id="contacto" class="py-24 border-t-2 border-edge">
  <div class="max-w-5xl mx-auto px-6">

    <SectionTitle number="04" label="Contacto" />

    <div class="max-w-3xl mx-auto">

      <div class="reveal flex items-center justify-center gap-3 mb-4">
        <p class="text-4xl md:text-5xl font-black leading-none">
          ¿Hablamos?
        </p>
        <Monigote variant="wave" class="w-16 shrink-0" />
      </div>

      <p class="reveal text-ink-soft leading-relaxed text-center max-w-xl mx-auto mb-10">
        Si tienes un proyecto en mente, una oferta o simplemente quieres
        saludar, escríbeme y te respondo lo antes posible.
      </p>

      <div class="reveal reveal-delay-1 p-6 sm:p-8 bg-paper-2 border-2 border-edge rounded-3xl">
        <FormularioContacto>
          {social.map((item) => (
            <a
              slot="enlaces"
              href={item.url}
              target="_blank"
              class="px-5 py-2.5 border-2 border-edge text-ink text-sm font-bold rounded-full hover:border-ink transition-colors"
            >
              {item.label} ↗
            </a>
          ))}
        </FormularioContacto>
      </div>

    </div>
  </div>
</section>
