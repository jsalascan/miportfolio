---
import { url } from "../utils/url"
import TemaToggle from "./TemaToggle.astro"

const year = new Date().getFullYear()

const legales = [
  { href: url("aviso-legal"), label: "Aviso legal" },
  { href: url("privacidad"), label: "Privacidad" },
  { href: url("cookies"), label: "Cookies" },
]
---

<footer class="py-10 border-t border-rule font-mono text-xs text-muted flex flex-wrap items-baseline justify-between gap-x-5 gap-y-3">
  <p class="flex flex-wrap gap-x-5 gap-y-1">
    <span>© {year} Jose Salas</span>
    {legales.map((l) => (
      <a href={l.href} class="hover:text-fg">{l.label}</a>
    ))}
  </p>
  <TemaToggle />
</footer>
